{
  "name": "SoundTouch IPA Archive",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Static site",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python3 -m http.server 8000 --directory /workspaces/SoundTouch-IPA-Archive >/tmp/soundtouch-site.log 2>&1 &"
}
